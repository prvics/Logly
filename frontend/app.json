{
  "expo": {
    "name": "Logly",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logly-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#365CF5",
        "foregroundImage": "./assets/logly-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logly-favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}